{
  "_comment": [
    "Cursor MCP config. Copy to .cursor/mcp.json (per project) or",
    "~/.cursor/mcp.json (all projects), and paste your personal token in",
    "place of <YOUR_TOKEN>.",
    "Cursor does not reliably expand ${ENV_VARS} in this file, so the token is",
    "written literally -- keep .cursor/mcp.json out of version control."
  ],
  "mcpServers": {
    "knowledge-graph": {
      "url": "https://litdbmyvvqrbpocohlpw.supabase.co/functions/v1/mcp",
      "headers": {
        "Authorization": "Bearer <YOUR_TOKEN>"
      }
    }
  }
}
